# Database Connection (Neon, Supabase, or Local Docker)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobmatcher

# AI Configuration (OpenAI or Gemini API via OpenAI-compatible endpoint)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Optional: Cohere API Key (Leave empty to use local FlashRank cross-encoder)
COHERE_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
APP_ENV=development
